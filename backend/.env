APP_NAME=Adrestia
APP_VERSION=0.1.0
DEBUG=true

# MVP_MOCK = fake models (no Ollama needed)
# LOCAL_MODEL = use Ollama on THIS machine (this app never downloads weights)
MODE=LOCAL_MODEL

DATABASE_URL=sqlite:///data/adrestia.db

JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720

OFFLINE_MODE=true

UPLOAD_DIR=./data/uploads
KNOWLEDGE_DIR=./data/knowledge
OUTPUT_DIR=./data/outputs
SANDBOX_DIR=./data/sandbox

MAX_FILE_SIZE_MB=25
TASK_TIMEOUT_SECONDS=300
CODE_TIMEOUT_SECONDS=10

# Friend's laptop: install Ollama, pull models THERE, then set MODE=LOCAL_MODEL
# and put the exact tag from `ollama list` below. Restart the backend.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_CODER_MODEL=qwen2.5-coder:1.5b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

